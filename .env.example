# Bu dosya örnektir. Varsayılanlarla çalışmak için .env oluşturmak gerekmez;
# değer değiştirmek isterseniz bu dosyayı .env olarak kopyalayın.

# PostgreSQL
POSTGRES_USER=yerlem
POSTGRES_PASSWORD=yerlem
POSTGRES_DB=yerlem

# Rota servisi (OSRM). Anahtar gerektirmez.
OSRM_URL=https://router.project-osrm.org
OSRM_TIMEOUT_MS=8000

# Adres arama servisi (OpenStreetMap Nominatim). Anahtar gerektirmez; saniyede en fazla 1 istek.
NOMINATIM_URL=https://nominatim.openstreetmap.org

# Bilgisayarınızda açılacak portlar
FRONTEND_PORT=8080
BACKEND_PORT=3000
DB_PORT=5432
